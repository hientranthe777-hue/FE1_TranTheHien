@model FE1_TranTheHien.ViewModels.HomeViewModel

<section class="banner" style="background-image: url('https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?q=80&w=2000&auto=format&fit=crop');">
    <div class="banner-content">
        <p>Spring Summer 2016</p>
        <h2>SEASON SALE - GET HUGE SAVINGS!</h2>
        <a href="#" class="btn-primary">SHOP NOW!</a>
    </div>
</section>

<section class="category-cards">
    <div class="container product-container">
        @foreach (var cat in Model.Categories)
        {
            <div class="category-item" style="background-image: url('@cat.ImageUrl');">
                <h3>@cat.Name</h3>
                <a href="#" class="btn-primary">SHOP NOW!</a>
            </div>
        }
    </div>
</section>

<section class="featured-products">
    <h2>FEATURED PRODUCTS</h2>
    <ul class="list-container">
        @foreach (var prod in Model.FeaturedProducts)
        {
            <li class="product-item">
                <div class="product-image-wrap">
                    @if (prod.IsSale)
                    {<span class="badge sale">SALE</span>}
                    @if (prod.IsNew)
                    {<span class="badge new">NEW</span>}
                    <img src="@prod.ImageUrl" alt="@prod.Name" />
                </div>
                <h3>@prod.Name</h3>
                <p class="price">$@prod.Price</p>
                <div class="color-swatches">
                    <span class="swatch red"></span>
                    <span class="swatch green"></span>
                    <span class="swatch blue"></span>
                </div>
            </li>
        }
    </ul>
</section>